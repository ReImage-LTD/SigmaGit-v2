{
  "name": "@sigmagit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "bun run --watch --env-file ../../.env src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --minify --packages=external",
    "start": "bun run --env-file ../../.env src/index.ts",
    "test": "bun test src/test",
    "test:security": "bun test src/test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-storage": "^3.1127.0",
    "@better-auth/api-key": "^1.7.3",
    "@better-auth/passkey": "^1.7.3",
    "@sigmagit/db": "workspace:*",
    "@sigmagit/lib": "workspace:*",
    "better-auth": "^1.7.3",
    "discord-interactions": "^4.4.0",
    "discord.js": "^14.27.0",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.7",
    "isomorphic-git": "^1.41.9",
    "nodemailer": "^10.0.0",
    "nostr-tools": "^2.25.2",
    "postgres": "^3.4.9",
    "rate-limiter-flexible": "^11.2.0",
    "redis": "^6.2.1",
    "resend": "^6.26.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "bun-types": "1.4.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
