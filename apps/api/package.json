    "better-auth": "^1.6.13",
    "discord-interactions": "^4.4.0",
    "discord.js": "^14.26.4",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.23",
    "isomorphic-git": "^1.38.3",
    "nodemailer": "^8.0.10",
    "nostr-tools": "^2.23.5",
