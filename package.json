{
  "name": "sigmagit",
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-sort-imports": "^1.8.11",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "private": true,
  "scripts": {
    "dev:web": "turbo dev --filter=@sigmagit/web --filter=@sigmagit/api --filter=@sigmagit/docs-vitepress",
    "dev:docs": "turbo dev --filter=@sigmagit/docs-vitepress",
    "dev:discord": "turbo dev --filter=@sigmagit/discord-bot",
    "build": "turbo build",
    "build:docs": "turbo build --filter=@sigmagit/docs-vitepress",
    "lint": "turbo lint",
    "test": "bun run --filter @sigmagit/api test",
    "test:api": "cd apps/api && bun test src/test",
    "test:security": "cd apps/api && bun test src/test",
    "db:migrate:discord": "cd packages/db && bun run db:migrate:discord",
    "discord:register": "cd apps/discord-bot && bun run register",
    "build:runner": "cd apps/runner && make build-agent",
    "users:list": "cd packages/db && bun run manage-users.ts list",
    "users:admin": "cd packages/db && bun run manage-users.ts promote",
    "users:help": "cd packages/db && bun run manage-users.ts help"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "vite": "^8.2.2",
    "esbuild": "^0.28.2"
  }
}
